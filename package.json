{
  "name": "ambler-app",
  "version": "0.3.0",
  "private": true,
  "description": "Ambler — private shared event, journey and activity storytelling.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios",
    "validate:production-assets": "node scripts/validate-production-assets.cjs",
    "check:source": "node scripts/check-source.cjs",
    "test:engine": "node scripts/test-engine.cjs",
    "test": "npm run check:source && npm run check:backend && npm run test:engine",
    "release:check": "npm test && npm run typecheck && npm run validate:production-assets",
    "check:backend": "node scripts/check-backend.cjs",
    "build:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.110.2",
    "expo": "52.0.49",
    "expo-application": "6.0.2",
    "expo-asset": "11.0.5",
    "expo-auth-session": "6.0.3",
    "expo-av": "15.0.2",
    "expo-constants": "17.0.8",
    "expo-crypto": "14.0.2",
    "expo-file-system": "18.0.12",
    "expo-font": "13.0.4",
    "expo-haptics": "14.0.1",
    "expo-image-manipulator": "13.0.6",
    "expo-image-picker": "16.0.6",
    "expo-keep-awake": "14.0.3",
    "expo-linear-gradient": "14.0.2",
    "expo-linking": "7.0.5",
    "expo-location": "18.0.10",
    "expo-media-library": "17.0.6",
    "expo-modules-core": "2.2.3",
    "expo-router": "4.0.22",
    "expo-secure-store": "14.0.1",
    "expo-sharing": "13.0.1",
    "expo-splash-screen": "0.29.24",
    "expo-status-bar": "2.0.1",
    "expo-system-ui": "4.0.9",
    "expo-video-thumbnails": "9.0.3",
    "lottie-react-native": "7.1.0",
    "query-string": "7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "2.20.2",
    "react-native-maps": "1.18.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.6.3"
  }
}
